{
  "name": "@koda.oss/glyph",
  "version": "1.0.0",
  "description": "Glyph — MinHash text fingerprints for similarity comparison",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "demo": "tsx demo.ts",
    "docs:related": "tsx scripts/docs-related.ts --write",
    "docs:related:check": "tsx scripts/docs-related.ts --check",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "glyph",
    "typescript",
    "minhash",
    "similarity",
    "fingerprint",
    "jaccard"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Koda-OSS/Glyph.git"
  },
  "homepage": "https://github.com/Koda-OSS/Glyph#readme",
  "bugs": {
    "url": "https://github.com/Koda-OSS/Glyph/issues"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=18"
  }
}
